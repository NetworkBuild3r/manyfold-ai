<%# INIT-027/SPEC-009 — thin creators index; page chrome in application/browse_index. %>
<%= render "application/browse_index", records: @creators, model_class: Creator,
      path_helper: :creators_path, empty_icon: "people", sentinel_prefix: "creators",
      grid_id: "creator-card-grid", card_selector: ".creator-card",
      storage_key_prefix: "scroll_creators_",
      show_unassigned: @unassigned_count.to_i > 0 && @browse_offset.to_i.zero?,
      unassigned_partial: "creators/unassigned",
      no_results: t(".no_results_html"), clear_filters: t(".clear_filters"),
      skip_link_label: t(".skip_creators"), end_message: t(".end_of_results"),
      error_message: t(".load_error"), loading_message: t(".loading_more"),
      scroll_hint: t(".scroll_hint"), back_to_top: t(".back_to_top"),
      new_path: new_creator_path, new_label: t("creators.general.new"),
      new_allowed: policy(:creator).new? %>
<% content_for :sidebar do %>
  <%= render "filters_card" %>
  <%= render "tags_card" %>
<% end %>
