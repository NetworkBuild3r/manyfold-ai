<%# INIT-027/SPEC-009 — creator card; chrome in application/browse_entity_card. %>
<% model_count = (@model_counts || {})[creator.id] || 0
  collection_count = (@collection_counts || {})[creator.id] || 0
%>
<%= render layout: "application/browse_entity_card", locals: {
      record: creator,
      card_class: "creator-card",
      title: creator.name,
      extra_html: nil,
      model_count: model_count,
      secondary_count: collection_count,
      show_secondary: collection_count > 0,
      models_href: creator_path(creator),
      secondary_href: collections_path(creator: creator),
      i18n_scope: "creators.creator",
      edit_path: edit_creator_path(creator),
      destroy_path: creator_path(creator),
      destroy_confirm: t("creators.destroy.confirm"),
      report_path: new_creator_report_path(creator)
    } do %>
  <div class="aspect-[4/3] bg-secondary-100 dark:bg-secondary-800 relative flex items-center justify-center overflow-hidden">
    <% if creator.banner.present? %>
      <img src="<%= banner_creator_path(creator) %>" alt="" class="absolute inset-0 w-full h-full object-cover opacity-35" loading="lazy" decoding="async">
    <% end %>
    <% if creator.avatar.present? %>
      <div class="relative z-[1]">
        <%= Avatar(url: avatar_creator_path(creator), size: :large) %>
      </div>
    <% else %>
      <span class="relative z-[1] text-secondary-400 dark:text-secondary-500 text-4xl" aria-hidden="true">
        <%= Icon icon: "people", label: "" %>
      </span>
    <% end %>
  </div>
<% end %>
