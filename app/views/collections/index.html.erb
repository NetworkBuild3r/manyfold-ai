<%# INIT-027/SPEC-009 — thin collections index; page chrome in application/browse_index. %>
<% show_unassigned = @unassigned_count.to_i > 0 && @browse_offset.to_i.zero? && !(@filter&.filtering_by?(:collection) || @filter&.filtering_by?(:creator)) %>
<%= render "application/browse_index", records: @collections, model_class: Collection,
      path_helper: :collections_path, empty_icon: "collection", sentinel_prefix: "collections",
      grid_id: "collection-card-grid", card_selector: ".collection-card",
      storage_key_prefix: "scroll_collections_",
      show_unassigned: show_unassigned, unassigned_partial: "collections/unassigned",
      no_results: t(".no_results_html"), clear_filters: t(".clear_filters"),
      skip_link_label: t(".skip_collections"), end_message: t(".end_of_results"),
      error_message: t(".load_error"), loading_message: t(".loading_more"),
      scroll_hint: t(".scroll_hint"), back_to_top: t(".back_to_top"),
      new_path: new_collection_path, new_label: t("collections.general.new"),
      new_allowed: policy(:collection).new? %>
<% content_for :sidebar do %>
  <%= render "filters_card" %>
  <%= render "tags_card" %>
<% end %>
