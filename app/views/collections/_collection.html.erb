<%# INIT-027/SPEC-009 — collection card; chrome in application/browse_entity_card. %>
<% model_count = (@model_counts || {})[collection.id] || 0
  collection_count = (@subcollection_counts || {})[collection.id] || 0
  extra_html = capture do
%>
    <div class="text-xs text-secondary-500 dark:text-secondary-400 truncate min-h-[1rem]">
      <% if collection.remote? %>
        <% creator_ext = collection.federails_actor&.extensions&.dig("attributedTo") %>
        <%= creator_ext["name"] if creator_ext.is_a?(Hash) %>
      <% elsif collection.creator %>
        <%= collection.creator.name %>
      <% end %>
    </div>
<%
  end
%>
<%= render layout: "application/browse_entity_card", locals: {
      record: collection,
      card_class: "collection-card",
      title: collection.name.careful_titleize,
      extra_html: extra_html,
      model_count: model_count,
      secondary_count: collection_count,
      show_secondary: collection_count > 0,
      models_href: collection_path(collection),
      secondary_href: collections_path(collection: collection),
      i18n_scope: "collections.collection",
      edit_path: edit_collection_path(collection),
      destroy_path: collection_path(collection),
      destroy_confirm: t("collections.destroy.confirm"),
      report_path: new_collection_report_path(collection)
    } do %>
  <%= PreviewFrame(object: collection) %>
<% end %>
